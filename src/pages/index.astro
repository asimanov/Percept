---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Header from '../components/Header.astro';
import Aside from '../components/Aside.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import Gallery from '../components/Gallery.astro';

const essayPosts = (await getCollection('essays'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const posts = essayPosts.slice(0, 11);

const artPosts = (await getCollection('art'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const fieldNotePosts = (await getCollection('field-notes'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = [
  ...fieldNotePosts.map((post) => ({
    post,
    url: `/field-notes/${post.id.replace(/\.md$/, '')}`,
    image: post.data.thumb,
  })),
  ...essayPosts.map((post) => ({
    post,
    url: `/essays/${post.id.replace(/\.md$/, '')}`,
    image: post.data.background,
  })),
]
  .sort((a, b) => b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 7);

const latestFeatured = latestPosts[0];
const latestRecent = latestPosts.slice(1);
---

<style>
/* ---- Landing layout: full-width feature row, aside drops below it ---- */
/* Base .Layout grid (global.css) is 2 rows: Masthead / Aside right, Main left.
   Landing uses 3 rows: nav + masthead, full-width Latest, then Main + Aside. */
@container app (inline-size>=800rem) {
	.Layout.Layout--landing {
		grid-template-rows: auto auto 1fr;
	}

	.Layout.Layout--landing .Landing-nav {
		grid-area: 1/1/2/2;
		padding-block-start: 6.25rem;
	}

	.Layout.Layout--landing .Landing-feature {
		grid-area: 2/1/3/4;
		/* Row 2 starts below the masthead (taller than the nav), leaving a dead
		   band under the nav — tuck the feature up into it. */
		margin-block-start: -30rem;
	}

	.Layout.Layout--landing .Main {
		grid-area: 3/1/4/2;
		padding-block-start: 0;
	}

	.Layout.Layout--landing .Aside {
		grid-area: 3/3/4/4;
	}
}

.landing-contact {
	list-style-type: none;
	margin: 0;
	padding: 0;
	display: flex;
	flex-direction: row;
	justify-content: space-between;

	li {
		a {
			border: none;

			&:after {
				display: none;
			}
		}
	}
}

.percept-container {
	display: flex;
	flex-direction: row;
	gap: 40px;
}

.percept-rc {
	width: 20%;

	h6 {
		word-break: break-all;

		span {
			display: inline-block;
		}
	}
}

.percept-rc__entry-container {
	.gallery {
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
	}
}

.percept-rc__entry {
	width: 100%;
	margin-bottom: 40rem;

	img {
		width: 100%;
		height: auto;
	}

	.bsln-card__body {
		padding-bottom: 0;
	}
}

.percept-journal {
	width: 80%;
}

.entry-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 40px;
}

.entry, .percept-rc__entry {
  --card-box-shadow: none;
  border-radius: 6px;
  box-sizing: border-box;
  border-bottom: none;
  background: none;
  border: 1px solid light-dark(var(--set-color-base-150),var(--set-color-base-900));
  border-radius: 0;
  position: relative;
  overflow: visible;

  .bsln-card__header,
  .bsln-card__body {
	background: none;
  }

  .bsln-card__body {
	padding-top: 16rem;
  }

  .meta {
	display: block;
	position: absolute;
	top: -12rem;
	background: var(--set-color-base);
	border: 1px solid light-dark(var(--set-color-base-150),var(--set-color-base-900));
	padding: 4rem 6rem;
	height: 22rem;

		time {
			display: block;
			line-height: 13rem;
			font-family: var(--set-font-mono);
		}
	}

  h5 {
	color: var(--set-color-purple);
  }

  &:hover {
	color: var(--set-color-purple);
  }
}

.excerpt {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  text-overflow: ellipsis;
  text-wrap: balance;
}

h5 {
	--set-font-size-h5: calc(14rem + 0.25vw);
	text-wrap: pretty;
}

.entry:first-child {
  grid-column: 1 / -1;
}

.header h3 {
	text-wrap: pretty;
}

/* ---- Latest (field notes + essays) section ---- */
/* Panels arrive vertical or horizontal in no fixed order, so the landing page
   stops reacting to their shape. Every thumbnail gets a fixed display frame
   and the artwork fills it via object-fit: cover - scaled to fill, never
   distorted, cropped for display only. Source files are untouched.
   The four knobs below are the whole layout; tune them here. */
.fn-section {
  --fn-thumb-ratio: 1 / 1;    /* grid thumbnail frame */
  --fn-grid-lines: 3;         /* excerpt lines, grid cards */
  --fn-featured-lines: 6;     /* excerpt lines, featured card */
  --fn-focal: center;         /* which part of a panel survives the crop */

  display: flex;
  flex-direction: row;
  gap: 40px;
  margin-bottom: 40px;
}

.fn-featured-wrap {
  width: 45%;
  /* The featured card is taken out of flow (below) so that the grid alone
     decides how tall this section is. Otherwise the two columns fight:
     whichever happens to be taller wins and the other is left short. */
  position: relative;
}

.fn-grid-wrap {
  width: 55%;
}

.fn-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  /* Frames are uniform, so this is only a guard against a stray card. */
  align-items: start;
}

.fn-featured,
.fn-entry {
  --card-box-shadow: none;
  box-sizing: border-box;
  background: none;
  border-bottom: none;
  border: 1px solid light-dark(var(--set-color-base-150),var(--set-color-base-900));
  border-radius: 0;
  display: block;
  position: relative;
  overflow: visible;

  .bsln-card__header,
  .bsln-card__body {
    background: none;
  }

  .bsln-card__body {
	padding: 10rem;
    padding-top: 16rem;
  }

  .meta {
    display: block;
    position: absolute;
    top: -12rem;
    background: var(--set-color-base);
    border: 1px solid light-dark(var(--set-color-base-150),var(--set-color-base-900));
    padding: 4rem 6rem;
    height: 22rem;

    time {
      display: block;
      line-height: 13rem;
      font-family: var(--set-font-mono);
    }
  }

  img {
    width: 100%;
    height: auto;
    display: block;
	padding: 16rem 10rem 0 10rem;
  }

  &:hover {
    color: var(--set-color-purple);
  }
}

/* Grid thumbnails: one fixed frame, every card identical height. */
.fn-entry img {
  aspect-ratio: var(--fn-thumb-ratio);
  object-fit: cover;
  object-position: var(--fn-focal);
}

/* Featured: the frame takes whatever height the grid beside it comes to, so
   the two halves always end flush regardless of what orientation leads. */
.fn-featured {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  /* .bsln-card ships flex-wrap: wrap; with a fixed height that wraps the body
     into a second column instead of stacking it under the image. */
  flex-wrap: nowrap;
}

.fn-featured img {
  flex: 1 1 auto;
  min-height: 0;
  object-fit: cover;
  object-position: var(--fn-focal);
}

.fn-featured .bsln-card__body {
  flex: 0 0 auto;
}

.fn-featured .fn-excerpt {
  -webkit-line-clamp: var(--fn-featured-lines);
  font-size: 1.05em;
}

.fn-entry .fn-excerpt {
  -webkit-line-clamp: var(--fn-grid-lines);
}

.fn-excerpt {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fn-entry .fn-excerpt {
  font-size: 0.8em;
}

.fn-view-all {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80px;
}

.title-action {
	h6 {
		display: inline;
	}

	.title-action__button {
		font-size: 0.65em;
		text-transform: uppercase;
		font-family: var(--set-font-mono);
		margin-left: 1em;
		border: 2px solid var(--link-style-color);
		padding: 0.25em 0.5em;
		font-weight: 900;
		letter-spacing: 2rem;
		line-height: normal;
	}
}

@media (max-width: 900px) {
  .entry-container {
    gap: 40px;
  }

  .entry:first-child {
    grid-column: 1 / -1;
  }

  .fn-section {
    flex-direction: column;
  }

  .fn-featured-wrap,
  .fn-grid-wrap {
    width: 100%;
  }

  .fn-featured {
    position: static;
    inset: auto;
  }

  .fn-featured img {
    flex: 0 0 auto;
    aspect-ratio: var(--fn-thumb-ratio);
  }
}

@media (max-width: 600px) {
	.percept-rc__entry-container {
		.gallery {
			flex-direction: row;
			justify-content: space-between;
			flex-wrap: wrap;
		}
	}

  .entry-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .percept-rc {
	width: 100%;

	h6 {
		font-size: var(--set-font-size-h6);
	}
  }

  .percept-journal {
	width: 100%;
  }

  .percept-container {
	flex-direction: column;
	gap: 20px;
  }

  .percept-rc__entry {
	max-width: 180px;
  }

  .entry:first-child {
    grid-column: 1 / -1;
  }

  .fn-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<div class="App">
			<div class="Layout Layout--landing">

				<div class="Masthead">
					<Header />
				</div>

				<div class="Landing-nav">
					<Nav />
				</div>

				<!-- Latest: field notes + essays — full-width feature row -->
				<section class="Landing-feature m-b-2">
						<div class="title-action m-b-2">
							<h6>Latest</h6>
							<a class="title-action__button" href="/field-notes" title="All Field Notes">
								<span>View All Field Notes</span> <i class="fa-sharp fa-light fa-arrows-to-eye"></i>
							</a>
						</div>

						<div class="fn-section">

							<div class="fn-featured-wrap">
								{latestFeatured && (
									<a href={latestFeatured.url} class="fn-featured bsln-card">
										<img src={latestFeatured.image} alt={latestFeatured.post.data.title} />
										<div class="bsln-card__body">
											<p class="meta">
												<time class="font-size--xs">
													<i class="fa-sharp fa-light fa-calendar"></i>
													{new Date(latestFeatured.post.data.pubDate).toLocaleDateString('en-us', { year: 'numeric', month: 'numeric', day: 'numeric' })}
												</time>
											</p>
											<p class="fn-excerpt">{latestFeatured.post.data.description}</p>
										</div>
									</a>
								)}
							</div>

							<div class="fn-grid-wrap">
								<div class="fn-grid">
									{latestRecent.map((entry) => (
										<a href={entry.url} class="fn-entry bsln-card">
											<img src={entry.image} alt={entry.post.data.title} />
											<div class="bsln-card__body">
												<p class="meta">
													<time class="font-size--xs">
														<i class="fa-sharp fa-light fa-calendar"></i>
														{new Date(entry.post.data.pubDate).toLocaleDateString('en-us', { year: 'numeric', month: 'numeric', day: 'numeric' })}
													</time>
												</p>
												<p class="fn-excerpt">{entry.post.data.description}</p>
											</div>
										</a>
									))}

									<!-- <a class="fn-entry bsln-card fn-view-all" href="/field-notes" title="All Field Notes">
										<div class="bsln-card__body text-align--center" style="padding: 0;">
											<span><i class="fa-sharp fa-light fa-arrows-to-eye fa-2xl"></i></span>
										</div>
									</a> -->
								</div>
							</div>

						</div>
					</section>

				<main class="Main">

					<!-- Hi! just a small update. -->
					<section class="m-b-2">
						<div class="container">
							<div class="row">
								<div class="col-12">

									<header>
										<!-- <div class="p-y-10 m-b-2" style="background: url(/assets/product/images/percept/landing-full-20.jpg) 50% no-repeat; background-size: cover; border-radius: 6rem;">
										</div> -->

										<div class="percept-info">
											<div class="row">

												<div class="col-xs-12 col-md-6">
													<div class="bsln-card bsln-card--hr m-b-1">

														<div class="bsln-card__body">
														<p class="no-margin"><i class="fa-sharp fa-light fa-clipboard-question"></i> What's all this about? <a href="/colophon" title="Colophon">Read More</a></p>
														</div>

													</div>
												</div>

												<div class="col-xs-12 col-md-6">
													<div class="bsln-card bsln-card--hr m-b-1">

														<div class="bsln-card__body">
														<p class="no-margin"><i class="fa-sharp fa-light fa-head-side-gear"></i> I want to learn! <a href="/learn" title="Learn">Read More</a></p>
														</div>

													</div>
												</div>

											</div>
										</div>
									</header>

								</div>
							</div>

						</div>
					</section>

					<div class="percept-container">

						<div class="percept-rc">

							<div class="title-action m-b-2">
								<h6>Art</h6>
								<a class="title-action__button" href="/art" title="Art Entries">
									<span>View All</span> <i class="fa-sharp fa-light fa-arrows-to-eye"></i>
								</a>
							</div>

							<div class="percept-rc__entry-container">

								<Gallery>
									{artPosts.map((post) => (
									<a
										class="percept-rc__entry bsln-card"
										href={post.data.asset}
										data-post-url={post.data.related}
									>
										<div class="bsln-card__body">
											<p class="meta">
												<time class="font-size--xs">
													<i class="fa-sharp fa-light fa-calendar"></i>

													{new Date(post.data.pubDate).toLocaleDateString('en-us', {
														year: 'numeric',
														month: 'numeric',
														day: 'numeric',
													})}
												</time>
											</p>
										<img
										src={post.data.thumb}
										alt={post.data.title || post.id}
										/>
										</div>
									</a>
									))}
								</Gallery>

								<!-- <a class="percept-rc__entry bsln-card" href="/art" title="Art Entries" style="min-height: 150rem; display: flex; align-items: center;justify-content: center;">
									<div class="bsln-card__body text-align--center" style="padding: 0;">
										<span><i class="fa-sharp fa-light fa-arrows-to-eye fa-2xl"></i></span>
									</div>
								</a> -->

							</div>

						</div>

						<div class="percept-journal">

							<div class="title-action m-b-2">
								<h6>Essays</h6>
								<a class="title-action__button" href="/essays" title="Essay Entries">
									<span>View All</span> <i class="fa-sharp fa-light fa-arrows-to-eye"></i>
								</a>
							</div>

							<div class="entry-container">

								{
									posts.map((post) => (

										<a href={`/essays/${post.id.replace(/\.md$/, '')}`} class="entry bsln-card">

											<div class="bsln-card__body">
												<p class="meta">
													<time class="font-size--xs">
														<i class="fa-sharp fa-light fa-calendar"></i>

														{new Date(post.data.pubDate).toLocaleDateString('en-us', {
															year: 'numeric',
															month: 'numeric',
															day: 'numeric',
														})}
													</time>
												</p>
												<h5>{post.data.title}</h5>
												<p class="excerpt">{post.data.description}</p>
											</div>

										</a>
									))
								}

								<!-- <a class="entry bsln-card" href="/essays" title="Essay Entries" style="min-height: 150rem; display: flex; align-items: center;justify-content: center;">
									<div class="bsln-card__body text-align--center" style="padding: 0;">
										<span><i class="fa-sharp fa-light fa-arrows-to-eye fa-2xl"></i></span>
									</div>
								</a> -->

							</div>

						</div>

					</div>

				</main>

				<div class="Aside">

					<Aside />

				</div>

			</div>

		<Footer />

		</div>
	</body>
</html>
